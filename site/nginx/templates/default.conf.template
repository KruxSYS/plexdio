# Plexdio website, downloads and update manifests (the entry service). Rendered by envsubst at container start;
# only ${PLEXDIO_*} variables are substituted (NGINX_ENVSUBST_FILTER), nginx's own $variables are left alone.
#
#   /                       the static site, baked into the image (clean URLs: /download -> download.html)
#   /healthz                200 "ok", from the image alone (healthy before anything is published)
#   /api/v1/version         update manifest per channel and package: ?channel=stable|beta&arch=x64|x64-setup
#                           -> /srv/releases/updates/<channel>/<arch>.json, or 404 (Screvia's endpoint and format)
#   /api/v1/releases        every published package -> /srv/releases/api/releases.json, or [] when none
#   /downloads/<ver>/<file> release files from the plexdio-releases volume (read-only)

# Only the channels and packages Plexdio ships; anything else never becomes part of a path.
map $arg_channel $plexdio_channel {
    default "";
    ""      stable;
    stable  stable;
    beta    beta;
}
map $arg_arch $plexdio_arch {
    default   "";
    ""        x64;
    x64       x64;
    x64-setup x64-setup;
}
# Binaries download as attachments; checksums and notes open as text.
map $uri $plexdio_disposition {
    default        "";
    ~*\.(exe|zip)$ attachment;
}

server {
    listen 8080 default_server;
    server_name _;
    root /usr/share/nginx/html;

    server_tokens off;
    charset utf-8;
    charset_types text/plain text/css application/javascript application/json image/svg+xml;
    client_max_body_size 16k;
    # Behind ai-pipe's proxy: never redirect to this container's own host and port.
    absolute_redirect off;

    gzip on;
    gzip_static on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 512;
    gzip_proxied any;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        add_header Cache-Control "no-store" always;
        return 200 "ok\n";
    }

    location = /api/v1/version {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "${PLEXDIO_MANIFEST_CACHE_CONTROL}" always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        default_type application/json;
        if ($plexdio_channel = "") {
            return 404 '{"error":"channel must be stable or beta."}\n';
        }
        if ($plexdio_arch = "") {
            return 404 '{"error":"arch must be x64 or x64-setup."}\n';
        }
        root /srv/releases;
        try_files /updates/$plexdio_channel/$plexdio_arch.json @no_release;
    }

    location @no_release {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "${PLEXDIO_MANIFEST_CACHE_CONTROL}" always;
        default_type application/json;
        return 404 '{"error":"No release has been published for this channel and package."}\n';
    }

    location = /api/v1/releases {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "${PLEXDIO_MANIFEST_CACHE_CONTROL}" always;
        add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;
        default_type application/json;
        root /srv/releases;
        try_files /api/releases.json /empty-releases.json;
    }

    # The [] answer while nothing is published (baked into the image).
    location = /empty-releases.json {
        internal;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "${PLEXDIO_MANIFEST_CACHE_CONTROL}" always;
        default_type application/json;
    }

    # Release files never change once published (a new version gets a new folder).
    location ^~ /downloads/ {
        root /srv/releases;
        autoindex off;
        gzip off;
        gzip_static off;
        types {
            application/vnd.microsoft.portable-executable exe;
            application/zip                               zip;
            text/plain                                    md;
        }
        default_type text/plain;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Content-Disposition $plexdio_disposition always;
        add_header Cache-Control "public, max-age=${PLEXDIO_DOWNLOAD_MAX_AGE}, immutable" always;
        location ~ /\. {
            return 404;
        }
    }

    location ~ /\. {
        return 404;
    }

    # Assets are not fingerprinted by name; pages link them with ?v=<content hash>.
    location ~* \.(?:css|js)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    location ~* \.(?:svg|png|ico|webp|woff2)$ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=86400" always;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/site-csp.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri.html $uri/ =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
        include /etc/nginx/snippets/security-headers.conf;
        include /etc/nginx/snippets/site-csp.conf;
        add_header Cache-Control "no-cache" always;
    }
}
