# Plexdio website settings. Copy to .env (git-ignored; ai-pipe keeps it between deploys). All are optional and
# there are no secrets: releases are published into the plexdio-releases volume by ./build.sh publish.

# Cache-Control of the update manifests and the release list (/api/v1/version, /api/v1/releases).
# no-cache (default) makes clients revalidate, so a new release is seen at once. Also: no-store, max-age=N.
MANIFEST_CACHE_CONTROL=no-cache

# max-age (seconds) of release files under /downloads/. A published version is never replaced, so they are
# also marked immutable. Default one year.
DOWNLOAD_MAX_AGE=31536000
